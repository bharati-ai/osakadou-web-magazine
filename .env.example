# Copy to .env.local (dev) or set in the server environment (production).

# Where the SQLite database and uploaded images live. Must be a persistent disk.
DATA_DIR=./data

# First admin account. Created only while the users table is empty; change the password after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=管理者

# Set to 1 only behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For / X-Forwarded-Host.
# TRUST_PROXY=1
